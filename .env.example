# Gemini and Walrus credentials are required.
FIXTRAIL_DATABASE_PATH=./data/fixtrail.db
APP_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_CAPACITY_FALLBACK_MODEL=gemini-3.5-flash-lite
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=

# Optional Telegram companion; webhook must be public HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
