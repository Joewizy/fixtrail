# Gemini and Walrus credentials are required.
# Supabase Dashboard → Connect → Transaction pooler (server-only).
# Replace the password placeholder and append ?sslmode=verify-full.
DATABASE_URL=
# Optional direct/session connection for migrations; falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
APP_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_CAPACITY_FALLBACK_MODEL=gemini-3.5-flash
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=

# Optional Telegram companion; webhook must be public HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
